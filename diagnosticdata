def get_service_did_hex(service) -> str:
    """
    Extract DID from a service by finding the DATA-ID param
    in the request definition.
    """
    if not service or not service.request:
        return ""

    for p in service.request.params:
        if p.semantic == "DATA-ID" and p.codedConstValue:
            try:
                return f"0x{int(p.codedConstValue, 16):04X}"
            except ValueError:
                return p.codedConstValue

    return ""
